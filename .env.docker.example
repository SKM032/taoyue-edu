# ============================================================
# 桃悦智科 Docker Compose 环境变量样例
# 用法：cp .env.docker.example .env  然后按需修改
# ============================================================

# ---------- 运行环境 ----------
# development / staging / production（生产会触发 app/config.py 的安全校验：JWT 密钥不得为默认值、DEBUG=false）
APP_ENV=production
DEBUG=false

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=taoyue_edu
MYSQL_USER=taoyue
MYSQL_PASSWORD=taoyue123456
# 是否把 3306 暴露到公网（生产建议改为 -1 或删除 ports 映射）
MYSQL_PORT=3306

# ---------- API 性能 ----------
# uvicorn worker 数：建议 = CPU 核数（2核=2，4核=4，不要超过核数否则抢占CPU导致100%）
API_WORKERS=2

# ---------- JWT 安全（生产必须改为随机强密钥！）----------
# 生成命令: openssl rand -hex 32
JWT_SECRET_KEY=taoyue-edu-jwt-secret-key-2024-very-strong-and-secure
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- CORS 跨域（JSON 数组，包含所有前端部署域名）----------
# 必须包含：主域名(PC/管理后台)、移动端独立二级域名(m.xin1024.top)
# 生产部署后改成你的真实域名
CORS_ORIGINS=["http://localhost","http://127.0.0.1","http://xin1024.top","http://www.xin1024.top","http://m.xin1024.top","https://xin1024.top","https://www.xin1024.top","https://m.xin1024.top"]

# ---------- 客户端构建参数 ----------
# 浏览器访问 API 的地址（部署后改成 http://你的域名/api/v1）
NEXT_PUBLIC_API_URL=http://localhost/api/v1
# 图片等静态资源域名（部署后改成 http://你的域名）
NEXT_PUBLIC_API_HOST=http://localhost

# ---------- 移动端 H5 (uni-app) ----------
# ⚠️ 移动端已改为"本地构建上传"方案：不再在服务器构建。
#    API 地址改到 deploy/build_m_local.bat 里的 API_BASE / API_HOST：
#      set API_BASE=http://m.你的域名/api/v1
#      set API_HOST=http://m.你的域名
#    （移动端走独立二级域名 m.你的域名，API 走同域名避免跨域）

# ---------- 管理后台构建参数 ----------
# 部署子路径
VITE_BASE=/admin/

# ---------- 微信支付（APIv3，企业级）----------
# 填齐后自动启用真实支付；留空保持模拟支付。
#   WECHAT_PAY_APP_ID         公众号/小程序/App 的 AppID
#   WECHAT_PAY_MCH_ID         商户号
#   WECHAT_PAY_APIV3_KEY      APIv3 密钥（商户平台「API安全-APIv3密钥」）
#   WECHAT_PAY_SERIAL_NO      商户 API 证书序列号
#   WECHAT_PAY_PRIVATE_KEY    商户 API 证书私钥（PEM 完整内容，注意用单引号包裹避免特殊字符被 shell 转义）
#   WECHAT_PAY_NOTIFY_URL     回调地址（公网 HTTPS），如 https://你的域名/api/v1/orders/wechat/notify
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_APIV3_KEY=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_NOTIFY_URL=

# ---------- 支付宝（电脑网站/手机网站支付）----------
# 到 open.alipay.com 创建应用并签约对应产品后获取：
#   ALIPAY_APP_ID         应用 AppId
#   ALIPAY_PRIVATE_KEY    应用私钥（PEM，含 BEGIN PRIVATE KEY）
#   ALIPAY_PUBLIC_KEY     支付宝公钥（PEM，含 BEGIN PUBLIC KEY）
#   ALIPAY_NOTIFY_URL     回调地址（公网 HTTPS），如 https://你的域名/api/v1/orders/alipay/notify
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
# 密钥文件路径（文件方案，指向容器内 /app/certs 下文件）
ALIPAY_PRIVATE_KEY_PATH=
ALIPAY_PUBLIC_KEY_PATH=
ALIPAY_NOTIFY_URL=

# ---------- 阿里云 OSS（可选，留空则图片保存到本地卷）----------
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET_NAME=
OSS_CDN_DOMAIN=

# ---------- 短信服务（阿里云号码认证服务 / 短信认证服务，可选）----------
# 未配置 AccessKey 时自动降级为模拟发送（验证码 123456 即可登录注册，仅供调试）
# 开通地址: https://dypns.console.aliyun.com/  (产品代号: PNVS)
# 获取方式: 阿里云控制台 → RAM 访问控制 → 创建 RAM 用户 → 授权 AliyunDysmsFullAccess
SMS_ACCESS_KEY=
SMS_SECRET_KEY=
# 签名名称: 在"短信认证参数配置-签名配置"页查看任一可用签名
SMS_SIGN_NAME=恒创联众
# 模板 CODE: 在"短信认证参数配置-模板配置"页选择验证码模板（登录注册用 100001）
SMS_TEMPLATE_ID=100001
# 方案名（可选，留空使用"默认方案"）
SMS_SCHEME_NAME=
