# =============================================================================
# 桃悦智科 根目录 .gitignore（安全底线 + 排除依赖/构建产物/运行时文件）
# 重要：本文件必须保持这些排除项，防止支付私钥、数据库密码、环境变量泄露
# =============================================================================

# -----------------------------------------------------------------------------
# 🔴 安全敏感（绝不提交！）
# -----------------------------------------------------------------------------
# 环境变量（含数据库密码、支付密钥、短信 AccessKey）
.env
.env.local
.env.*
!.env.docker.example

# 证书/私钥/密钥文件（微信支付私钥、支付宝私钥等）
certs/
*.pem
*.key
*.p12
*.pfx

# 日志（可能含敏感信息）
*.log
backend.log

# -----------------------------------------------------------------------------
# 🔴 Python 依赖与缓存（后端 taoyue-edu-api）
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.so
venv/
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 后端运行时上传的图片/文件（由管理后台上传，应存在服务器，不进 git）
taoyue-edu-api/static/uploads/

# 后端临时诊断/测试脚本（不进仓库）
taoyue-edu-api/_test_cache.py
taoyue-edu-api/_test_homepage.py
taoyue-edu-api/_test_speed.py

# -----------------------------------------------------------------------------
# 🔴 Node.js / 前端依赖与构建产物（taoyue-edu / taoyue_edu_admin / m）
# -----------------------------------------------------------------------------
node_modules/
dist/
dist-web/
dist-build/
.next/
out/
.nuxt/

# m 端（uni-app H5）构建产物
m/dist/
m/unpackage/
m/h5/

# 编译缓存
.tsbuildinfo

# -----------------------------------------------------------------------------
# 本地素材/临时目录（不进仓库，避免仓库臃肿）
# -----------------------------------------------------------------------------
generated-images/
素材/
*.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.tmp
